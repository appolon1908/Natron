FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CODESTRA_AUTH_MODE=required CODESTRA_EXECUTION_ENABLED=false
WORKDIR /app
COPY requirements-saas.txt ./
RUN pip install --no-cache-dir -r requirements-saas.txt && useradd --create-home --uid 10001 codestra && mkdir -p /data/inputs /data/outputs && chown -R codestra:codestra /data
COPY codestra_saas.py ./
USER codestra
ENV CODESTRA_DB_PATH=/data/jobs.sqlite3 CODESTRA_INPUT_ROOT=/data/inputs CODESTRA_OUTPUT_ROOT=/data/outputs
EXPOSE 8080
CMD ["uvicorn", "codestra_saas:app", "--host", "0.0.0.0", "--port", "8080"]
